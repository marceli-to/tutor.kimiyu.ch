{
    "pattern": "sliders",
    "description": "Ein Blatt mit Reglern für Licht, CO₂ und Wasser. Die Pfeile für Sauerstoff und Traubenzucker werden stärker oder schwächer, je nachdem, welche Zutat am knappsten ist.",
    "css": ":root{\n  --leaf:#3E8E41; --leaf-dark:#1F4D2B; --leaf-light:#A6D08A;\n  --sun:#F2B705; --water:#2F7FC1; --gas:#7A8580; --o2:#17A085; --sugar:#C0572B;\n}\n:root[data-theme=\"dark\"]{\n  --leaf:#5DB060; --leaf-dark:#A6D08A; --leaf-light:#2F6B34; --gas:#9AA59F;\n}\n.controls{display:grid;gap:.6rem;margin-top:.5rem}\n#hint{color:var(--muted);font-size:1rem;margin:.9rem 0 0}\n.fl{stroke-dasharray:7 6}\n@media (prefers-reduced-motion: no-preference){.fl{animation:flow 1.2s linear infinite}}\n@keyframes flow{to{stroke-dashoffset:-26}}",
    "markup": "<section class=\"stage\" aria-label=\"Interaktives Blatt\">\n<svg viewBox=\"0 0 680 370\" role=\"img\" aria-labelledby=\"st sd\">\n<title id=\"st\">Fotosynthese im Blatt</title>\n<desc id=\"sd\">Licht, CO₂ und Wasser gehen ins Blatt. Traubenzucker und Sauerstoff kommen heraus.</desc>\n<defs><marker id=\"ar\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"5\" markerHeight=\"5\" orient=\"auto-start-reverse\"><path d=\"M2 1L8 5L2 9\" fill=\"none\" stroke=\"context-stroke\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></marker></defs>\n<g id=\"sun\">\n<circle cx=\"90\" cy=\"70\" r=\"30\" fill=\"var(--sun)\"/>\n<g stroke=\"var(--sun)\" stroke-width=\"3\" stroke-linecap=\"round\">\n<line x1=\"90\" y1=\"24\" x2=\"90\" y2=\"12\"/><line x1=\"90\" y1=\"116\" x2=\"90\" y2=\"128\"/><line x1=\"44\" y1=\"70\" x2=\"32\" y2=\"70\"/><line x1=\"136\" y1=\"70\" x2=\"148\" y2=\"70\"/>\n<line x1=\"58\" y1=\"38\" x2=\"49\" y2=\"29\"/><line x1=\"122\" y1=\"38\" x2=\"131\" y2=\"29\"/><line x1=\"58\" y1=\"102\" x2=\"49\" y2=\"111\"/>\n</g></g>\n<text x=\"160\" y=\"40\" fill=\"var(--ink)\" font-size=\"16\" font-weight=\"700\">Licht</text>\n<path d=\"M340 330 L340 300\" stroke=\"var(--leaf-dark)\" stroke-width=\"5\" fill=\"none\"/>\n<path d=\"M340 300 C300 290,230 240,240 190 C250 130,320 95,420 110 C470 118,470 150,455 185 C430 250,380 290,340 300 Z\" fill=\"var(--leaf-light)\" stroke=\"var(--leaf-dark)\" stroke-width=\"1.5\"/>\n<path d=\"M340 300 C350 240,380 170,430 125\" stroke=\"var(--leaf-dark)\" stroke-width=\"1.5\" fill=\"none\"/>\n<g id=\"chloro\" fill=\"var(--leaf-dark)\">\n<ellipse cx=\"300\" cy=\"200\" rx=\"9\" ry=\"6\"/><ellipse cx=\"330\" cy=\"170\" rx=\"9\" ry=\"6\"/><ellipse cx=\"370\" cy=\"150\" rx=\"9\" ry=\"6\"/><ellipse cx=\"310\" cy=\"245\" rx=\"9\" ry=\"6\"/>\n<ellipse cx=\"400\" cy=\"200\" rx=\"9\" ry=\"6\"/><ellipse cx=\"270\" cy=\"220\" rx=\"9\" ry=\"6\"/><ellipse cx=\"420\" cy=\"150\" rx=\"9\" ry=\"6\"/><ellipse cx=\"365\" cy=\"235\" rx=\"9\" ry=\"6\"/>\n</g>\n<line id=\"aL\" class=\"fl\" x1=\"122\" y1=\"92\" x2=\"268\" y2=\"160\" stroke=\"var(--sun)\" marker-end=\"url(#ar)\"/>\n<line id=\"aC\" class=\"fl\" x1=\"70\" y1=\"240\" x2=\"228\" y2=\"222\" stroke=\"var(--gas)\" marker-end=\"url(#ar)\"/>\n<text x=\"30\" y=\"272\" fill=\"var(--ink)\" font-size=\"15\">CO₂ aus der Luft</text>\n<line id=\"aW\" class=\"fl\" x1=\"340\" y1=\"366\" x2=\"340\" y2=\"336\" stroke=\"var(--water)\" marker-end=\"url(#ar)\"/>\n<text x=\"352\" y=\"356\" fill=\"var(--ink)\" font-size=\"15\">Wasser von den Wurzeln</text>\n<line id=\"aO\" class=\"fl\" x1=\"462\" y1=\"150\" x2=\"560\" y2=\"110\" stroke=\"var(--o2)\" marker-end=\"url(#ar)\"/>\n<text x=\"540\" y=\"94\" fill=\"var(--ink)\" font-size=\"15\">Sauerstoff (O₂)</text>\n<line id=\"aZ\" class=\"fl\" x1=\"440\" y1=\"230\" x2=\"540\" y2=\"262\" stroke=\"var(--sugar)\" marker-end=\"url(#ar)\"/>\n<text x=\"548\" y=\"266\" fill=\"var(--ink)\" font-size=\"15\">Traubenzucker</text>\n<text x=\"548\" y=\"285\" fill=\"var(--muted)\" font-size=\"13\">Energie für</text>\n<text x=\"548\" y=\"302\" fill=\"var(--muted)\" font-size=\"13\">die Pflanze</text>\n<line x1=\"370\" y1=\"150\" x2=\"440\" y2=\"62\" stroke=\"var(--muted)\" stroke-width=\"1\" stroke-dasharray=\"3 3\"/>\n<text x=\"446\" y=\"58\" fill=\"var(--muted)\" font-size=\"13\">Chloroplasten</text>\n</svg>\n\n<div class=\"controls\">\n<div class=\"ctl\"><label for=\"l\">Licht</label><input type=\"range\" id=\"l\" min=\"0\" max=\"100\" step=\"1\" value=\"80\"><output id=\"lo\" for=\"l\">80%</output></div>\n<div class=\"ctl\"><label for=\"c\">CO₂</label><input type=\"range\" id=\"c\" min=\"0\" max=\"100\" step=\"1\" value=\"60\"><output id=\"co\" for=\"c\">60%</output></div>\n<div class=\"ctl\"><label for=\"w\">Wasser</label><input type=\"range\" id=\"w\" min=\"0\" max=\"100\" step=\"1\" value=\"90\"><output id=\"wo\" for=\"w\">90%</output></div>\n</div>\n<div class=\"readout\" aria-live=\"polite\">\n<div><small>Fotosynthese-Leistung</small><strong id=\"rate\">60%</strong></div>\n<div><small>Bremst gerade</small><strong id=\"lim\">CO₂</strong></div>\n</div>\n<p id=\"hint\"></p>\n</section>",
    "script": "(function(){\nconst ids={l:'aL',c:'aC',w:'aW'}, names={l:'Licht',c:'CO₂',w:'Wasser'};\nconst $=id=>document.getElementById(id);\nfunction sty(el,v){el.setAttribute('stroke-width',(1.5+v/100*5).toFixed(1));el.setAttribute('opacity',(0.15+0.85*v/100).toFixed(2));}\nfunction upd(){\n  const v={};\n  for(const k of ['l','c','w']){v[k]=+$(k).value;$(k+'o').textContent=v[k]+'%';sty($(ids[k]),v[k]);}\n  const r=Math.min(v.l,v.c,v.w);\n  const k=Object.keys(v).reduce((a,b)=>v[a]<=v[b]?a:b);\n  sty($('aO'),r);sty($('aZ'),r);\n  $('chloro').setAttribute('opacity',(0.25+0.75*r/100).toFixed(2));\n  $('sun').setAttribute('opacity',(0.15+0.85*v.l/100).toFixed(2));\n  $('rate').textContent=Math.round(r)+'%';\n  $('lim').textContent=r>=100?'Nichts':names[k];\n  $('hint').textContent=r===0?'Ohne '+names[k]+' läuft gar nichts, auch wenn alles andere reichlich da ist.':(r>=100?'Alles optimal: Die Pflanze arbeitet auf Hochtouren.':'Mehr '+names[k]+' würde am meisten bringen. Die anderen Zutaten zu erhöhen, nützt jetzt nichts.');\n}\ndocument.querySelectorAll('input[type=range]').forEach(i=>i.addEventListener('input',upd));\nupd();\n})();"
}
